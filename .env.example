# ========================================================
# AcxiomCRM Enterprise - Environment Configuration Template
# ========================================================

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Database Provider: 'Sqlite' (default zero-config) or 'SqlServer'
DATABASE_PROVIDER=Sqlite

# Connection Strings
# SQLite (default):
ConnectionStrings__DefaultConnection=Data Source=AcxiomCRM.db

# SQL Server (Production / Docker):
# ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=AcxiomCRM;User Id=sa;Password=YourStrong(!)Password2026;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Application Security
SECURITY_COOKIE_SECURE_POLICY=SameAsRequest
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_TIME_SPAN_MINUTES=15
