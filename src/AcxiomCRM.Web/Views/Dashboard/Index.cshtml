@model AcxiomCRM.Application.DTOs.DashboardMetricsDto
@{
    ViewData["Title"] = "CRM Dashboard";
    string currentFilter = ViewBag.DateFilter ?? "all";
    string userRole = ViewBag.UserRole ?? "SalesExecutive";
}

<!-- Page Header & Filter Toolbar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Dashboard</h3>
            <span class="badge bg-primary bg-opacity-10 text-primary">@userRole Scope</span>
        </div>
        <p class="text-muted small mb-0">Real-time performance analytics, pipeline distribution, and pending activities</p>
    </div>

    <!-- Date Filters -->
    <div class="btn-group shadow-sm bg-white p-1 rounded-3 border" role="group">
        <a asp-action="Index" asp-route-dateFilter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-primary" : "btn-light")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="today" class="btn btn-sm @(currentFilter == "today" ? "btn-primary" : "btn-light")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="week" class="btn btn-sm @(currentFilter == "week" ? "btn-primary" : "btn-light")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="month" class="btn btn-sm @(currentFilter == "month" ? "btn-primary" : "btn-light")">This Month</a>
    </div>
</div>

<!-- Row 1: Primary KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Customers</div>
                    <div class="kpi-value text-primary">@Model.TotalCustomers</div>
                </div>
                <div class="kpi-icon-wrap bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <a asp-controller="Customer" asp-action="Index" class="small text-decoration-none text-muted mt-2 d-inline-block">View all &rarr;</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Total Leads</div>
                    <div class="kpi-value text-info">@Model.TotalLeads</div>
                </div>
                <div class="kpi-icon-wrap bg-info bg-opacity-10 text-info">
                    <i class="bi bi-funnel"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Open: <strong>@Model.OpenLeads</strong></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Opportunities</div>
                    <div class="kpi-value text-dark">@Model.TotalOpportunities</div>
                </div>
                <div class="kpi-icon-wrap bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-briefcase"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Active: <strong>@Model.OpenOpportunities</strong></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Won Deals</div>
                    <div class="kpi-value text-success">@Model.WonOpportunities</div>
                </div>
                <div class="kpi-icon-wrap bg-success bg-opacity-10 text-success">
                    <i class="bi bi-trophy"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Lost: <strong class="text-danger">@Model.LostOpportunities</strong></div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Upcoming Tasks</div>
                    <div class="kpi-value text-warning">@Model.UpcomingFollowUps</div>
                </div>
                <div class="kpi-icon-wrap bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <a asp-controller="FollowUp" asp-action="Upcoming" class="small text-decoration-none text-muted mt-2 d-inline-block">Calendar &rarr;</a>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="kpi-card @(Model.OverdueFollowUps > 0 ? "border-danger border-opacity-50" : "")">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-title">Overdue Tasks</div>
                    <div class="kpi-value @(Model.OverdueFollowUps > 0 ? "text-danger" : "text-muted")">@Model.OverdueFollowUps</div>
                </div>
                <div class="kpi-icon-wrap bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
            <a asp-controller="FollowUp" asp-action="Overdue" class="small text-decoration-none text-danger mt-2 d-inline-block">Resolve now &rarr;</a>
        </div>
    </div>
</div>

<!-- Row 2: Pipeline Value Highlighting -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #1e3a8a, #2563eb);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-white-50 text-uppercase small fw-semibold tracking-wider">Active Pipeline Value</div>
                    <div class="display-6 fw-bold mt-1">@Model.TotalPipelineValue.ToString("C0")</div>
                    <div class="small text-white-50 mt-1">Based on @Model.OpenOpportunities unclosed opportunities in your scope</div>
                </div>
                <div class="display-4 text-white-50 opacity-50"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #0f766e, #0d9488);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-white-50 text-uppercase small fw-semibold tracking-wider">Weighted Forecast Value</div>
                    <div class="display-6 fw-bold mt-1">@Model.WeightedPipelineValue.ToString("C0")</div>
                    <div class="small text-white-50 mt-1">Calculated as &sum; (Amount &times; Probability / 100)</div>
                </div>
                <div class="display-4 text-white-50 opacity-50"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Interactive Charts -->
<div class="row g-3 mb-4">
    <!-- Chart 1: Lead Status Distribution -->
    <div class="col-lg-4">
        <div class="crm-card h-100 mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pie-chart me-2 text-primary"></i>Lead Status Breakdown</h5>
            </div>
            <div class="crm-card-body d-flex align-items-center justify-content-center" style="min-height: 280px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline by Stage -->
    <div class="col-lg-4">
        <div class="crm-card h-100 mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-bar-chart-steps me-2 text-info"></i>Pipeline by Stage ($)</h5>
            </div>
            <div class="crm-card-body d-flex align-items-center justify-content-center" style="min-height: 280px;">
                <canvas id="oppStageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales Trend -->
    <div class="col-lg-4">
        <div class="crm-card h-100 mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-graph-up me-2 text-success"></i>Monthly Won Revenue</h5>
            </div>
            <div class="crm-card-body d-flex align-items-center justify-content-center" style="min-height: 280px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Row 4: Quick Action Lists -->
<div class="row g-3">
    <!-- Urgent Follow-ups -->
    <div class="col-lg-6">
        <div class="crm-card mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-clock-history me-2 text-warning"></i>Immediate Follow-Ups</h5>
                <a asp-controller="FollowUp" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.RecentFollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="crm-table">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Related To</th>
                                    <th>Due Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.RecentFollowUps)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border me-1">@f.FollowUpType</span>
                                            <span class="fw-semibold">@f.Subject</span>
                                        </td>
                                        <td class="small text-muted">
                                            @(f.CustomerName ?? f.LeadName ?? "General")
                                        </td>
                                        <td>
                                            <span class="@(f.IsOverdue ? "text-danger fw-bold" : "text-dark")">
                                                @f.FollowUpDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </td>
                                        <td>
                                            <form asp-controller="FollowUp" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Done">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-check2-circle text-success fs-1"></i>
                        <p class="mb-0 mt-2 small">No pending follow-ups in this scope!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top Opportunities -->
    <div class="col-lg-6">
        <div class="crm-card mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-star me-2 text-primary"></i>Top Active Opportunities</h5>
                <a asp-controller="Opportunity" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.TopOpportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="crm-table">
                            <thead>
                                <tr>
                                    <th>Opportunity</th>
                                    <th>Customer</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.TopOpportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                                @o.OpportunityName
                                            </a>
                                        </td>
                                        <td class="small text-muted">@o.CustomerName</td>
                                        <td><span class="badge bg-info bg-opacity-10 text-info">@o.Stage</span></td>
                                        <td class="fw-bold text-dark">@o.Amount.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-briefcase text-muted fs-1"></i>
                        <p class="mb-0 mt-2 small">No active opportunities in pipeline.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Lead Status Chart
            const leadCtx = document.getElementById("leadStatusChart");
            if (leadCtx) {
                new Chart(leadCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.Labels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.Data)),
                            backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart.Colors)),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                        }
                    }
                });
            }

            // 2. Opportunity Stage Chart
            const oppCtx = document.getElementById("oppStageChart");
            if (oppCtx) {
                new Chart(oppCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageChart.Labels)),
                        datasets: [{
                            label: 'Pipeline Value ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageChart.Data)),
                            backgroundColor: '#0284c7',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            // 3. Monthly Sales Chart
            const salesCtx = document.getElementById("monthlySalesChart");
            if (salesCtx) {
                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart.Labels)),
                        datasets: [{
                            label: 'Won Revenue ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart.Data)),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        });
    </script>
}
