@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.ActivityDto>
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Sales Activities</h3>
        <p class="text-muted small mb-0">Audit history of calls, meetings, emails, and tasks performed with clients</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-clock-history me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Search subject or description..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<ActivityType>()">
                    <option value="">All Activity Types</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<ActivityStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Related To</th>
                            <th>Activity Date</th>
                            <th>Owner</th>
                            <th>Status</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @(a.ActivityType == ActivityType.Call ? "bi-telephone" : a.ActivityType == ActivityType.Meeting ? "bi-people" : a.ActivityType == ActivityType.Email ? "bi-envelope" : "bi-check2-square") me-1"></i>
                                        @a.ActivityType
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@a.Subject</td>
                                <td class="small text-muted">
                                    @(a.CustomerName != null ? $"Customer: {a.CustomerName}" : a.LeadName != null ? $"Lead: {a.LeadName}" : "-")
                                </td>
                                <td>@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="small">@a.AssignedUserName</td>
                                <td>
                                    <span class="badge @(a.Status == ActivityStatus.Completed ? "bg-success bg-opacity-10 text-success" : "bg-light text-dark border")">
                                        @a.Status
                                    </span>
                                </td>
                                <td class="small text-muted text-truncate" style="max-width: 180px;">
                                    @(a.Description ?? "-")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-light border" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" id="del-@a.ActivityId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-light border text-danger" title="Delete" onclick="confirmAction('Are you sure you want to remove this activity log?', 'del-@a.ActivityId')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-clock-history"></i>
                <h5>No Activities Logged</h5>
                <p class="small">Log interaction details after calls, meetings, or email threads.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Log First Activity</a>
            </div>
        }
    </div>
</div>
