@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.CustomerDto>
@{
    ViewData["Title"] = "Customer Report";
    var filter = ViewBag.Filter as AcxiomCRM.Application.DTOs.ReportFilterDto;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Customer Master Report</h3>
        <p class="text-muted small mb-0">Filtered view of client organizations, geographic distribution, and account ownership</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCustomerReport" asp-route-searchTerm="@filter?.SearchTerm" asp-route-status="@filter?.Status" class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-light border">Back to Hub</a>
    </div>
</div>

<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Search customer, email..." value="@filter?.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<CustomerStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter Report</button>
                <a asp-action="CustomerReport" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>City / State</th>
                            <th>Status</th>
                            <th>Assigned Exec</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@c.CustomerCode</td>
                                <td class="fw-semibold">@c.CustomerName</td>
                                <td>@(c.CompanyName ?? "-")</td>
                                <td>@c.Email</td>
                                <td>@c.Phone</td>
                                <td>@(c.City != null ? $"{c.City}, {c.State}" : "-")</td>
                                <td><span class="badge-status badge-status-@c.Status.ToString().ToLower()">@c.Status</span></td>
                                <td>@c.AssignedUserName</td>
                                <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <h5>No Records in Customer Report</h5>
            </div>
        }
    </div>
</div>
