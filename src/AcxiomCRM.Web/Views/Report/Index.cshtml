@inject AcxiomCRM.Application.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Reports & Analytics Hub";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Reports & Analytics Hub</h3>
        <p class="text-muted small mb-0">Role-scoped intelligence, exportable CSV reports, pipeline forecasts, and activity audits</p>
    </div>
</div>

<div class="row g-3">
    <!-- 1. Customer Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Operational</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Customer Report</h5>
                <p class="text-muted small">Account master list, contact coordinates, status, and assigned executive owners.</p>
            </div>
            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                <a asp-action="CustomerReport" class="btn btn-sm btn-primary flex-fill">View Report</a>
                <a asp-action="ExportCustomerReport" class="btn btn-sm btn-outline-secondary" title="Export CSV"><i class="bi bi-download"></i></a>
            </div>
        </div>
    </div>

    <!-- 2. Lead Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-info bg-opacity-10 text-info">
                        <i class="bi bi-funnel"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Acquisition</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Lead Report</h5>
                <p class="text-muted small">Prospective leads by marketing source, priority tier, qualification, and value.</p>
            </div>
            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                <a asp-action="LeadReport" class="btn btn-sm btn-primary flex-fill">View Report</a>
                <a asp-action="ExportLeadReport" class="btn btn-sm btn-outline-secondary" title="Export CSV"><i class="bi bi-download"></i></a>
            </div>
        </div>
    </div>

    <!-- 3. Opportunity Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Pipeline</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Opportunity Report</h5>
                <p class="text-muted small">Active deal stages, win probabilities, contract values, and target close dates.</p>
            </div>
            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                <a asp-action="OpportunityReport" class="btn btn-sm btn-primary flex-fill">View Report</a>
                <a asp-action="ExportOpportunityReport" class="btn btn-sm btn-outline-secondary" title="Export CSV"><i class="bi bi-download"></i></a>
            </div>
        </div>
    </div>

    <!-- 4. Follow-Up Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Engagement</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Follow-Up Report</h5>
                <p class="text-muted small">Planned, completed, missed, and overdue touchpoint tasks and completion rates.</p>
            </div>
            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                <a asp-action="FollowUpReport" class="btn btn-sm btn-primary flex-fill">View Report</a>
                <a asp-action="ExportFollowUpReport" class="btn btn-sm btn-outline-secondary" title="Export CSV"><i class="bi bi-download"></i></a>
            </div>
        </div>
    </div>

    <!-- 5. Sales Pipeline Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-success bg-opacity-10 text-success">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Strategic</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Sales Pipeline Report</h5>
                <p class="text-muted small">Stage-wise and rep-wise weighted revenue projections and forecast accuracy.</p>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a asp-action="PipelineReport" class="btn btn-sm btn-outline-primary w-100">View Pipeline Analysis</a>
            </div>
        </div>
    </div>

    <!-- 6. Conversion Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <span class="badge bg-light text-dark border">Conversion</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">Lead Conversion Report</h5>
                <p class="text-muted small">Qualification velocity, conversion rates by channel, and lost opportunity review.</p>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a asp-action="ConversionReport" class="btn btn-sm btn-outline-primary w-100">View Conversion Rates</a>
            </div>
        </div>
    </div>

    <!-- 7. User Activity Report -->
    <div class="col-md-6 col-lg-3">
        <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="kpi-icon-wrap bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-activity"></i>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Performance</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">User Activity Report</h5>
                <p class="text-muted small">Sales representative call volumes, meetings hosted, and closed task metrics.</p>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a asp-action="UserActivityReport" class="btn btn-sm btn-outline-primary w-100">View Rep Productivity</a>
            </div>
        </div>
    </div>

    <!-- 8. Audit Report (Admin only) -->
    @if (CurrentUser.IsAdmin)
    {
        <div class="col-md-6 col-lg-3">
            <div class="crm-card h-100 p-4 d-flex flex-column justify-content-between border-danger border-opacity-25">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="kpi-icon-wrap bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-shield-shaded"></i>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger">Compliance</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Security Audit Report</h5>
                    <p class="text-muted small">Complete timeline of authentication events, user updates, and data modifications.</p>
                </div>
                <div class="mt-3 pt-3 border-top">
                    <a asp-action="AuditReport" class="btn btn-sm btn-outline-danger w-100">Audit Trail Analysis</a>
                </div>
            </div>
        </div>
    }
</div>
