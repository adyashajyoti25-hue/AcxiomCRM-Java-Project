@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.FollowUpDto>
@{
    ViewData["Title"] = "Follow-Up Report";
    var filter = ViewBag.Filter as AcxiomCRM.Application.DTOs.ReportFilterDto;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Follow-Up & Engagement Report</h3>
        <p class="text-muted small mb-0">Scheduled, completed, missed, and overdue tasks across all accounts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportFollowUpReport" asp-route-status="@filter?.Status" class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-light border">Back to Hub</a>
    </div>
</div>

<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="FromDate" class="form-control form-control-sm" value="@(filter?.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <input type="date" name="ToDate" class="form-control form-control-sm" value="@(filter?.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="FollowUpReport" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Related Customer / Lead</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Completed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Items)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                <td class="fw-semibold">@f.Subject</td>
                                <td class="small text-muted">@(f.CustomerName ?? f.LeadName ?? "-")</td>
                                <td>@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge-status badge-status-@f.Status.ToString().ToLower()">@f.Status</span></td>
                                <td>@f.AssignedUserName</td>
                                <td>@(f.CompletedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h5>No Records in Follow-Up Report</h5>
            </div>
        }
    </div>
</div>
