@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.OpportunityDto>
@{
    ViewData["Title"] = "Opportunity Report";
    var filter = ViewBag.Filter as AcxiomCRM.Application.DTOs.ReportFilterDto;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Opportunity Pipeline Report</h3>
        <p class="text-muted small mb-0">Commercial opportunities, stage progressions, win probabilities, and contract values</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportOpportunityReport" asp-route-stage="@filter?.Stage" asp-route-status="@filter?.Status" class="btn btn-sm btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
        </a>
        <a asp-action="Index" class="btn btn-sm btn-light border">Back to Hub</a>
    </div>
</div>

<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Search opportunity or customer..." value="@filter?.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="Stage" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<OpportunityStage>()">
                    <option value="">All Stages</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<OpportunityStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="OpportunityReport" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Opportunity Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Prob.</th>
                            <th>Weighted Value</th>
                            <th>Expected Close</th>
                            <th>Status</th>
                            <th>Owner</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@o.OpportunityName</td>
                                <td>@o.CustomerName</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary">@o.Stage</span></td>
                                <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                <td>@o.Probability%</td>
                                <td class="text-success fw-bold">@o.WeightedValue.ToString("C0")</td>
                                <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge-status badge-status-@o.Status.ToString().ToLower()">@o.Status</span></td>
                                <td>@o.AssignedUserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-briefcase"></i>
                <h5>No Records in Opportunity Report</h5>
            </div>
        }
    </div>
</div>
