@model dynamic
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Sales Representative Activity Report</h3>
        <p class="text-muted small mb-0">Team productivity audit tracking completed calls, client meetings, sent emails, and tasks</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-light border">Back to Hub</a>
</div>

<div class="crm-card">
    <div class="crm-card-body p-0">
        <table class="crm-table">
            <thead>
                <tr>
                    <th>Sales Representative</th>
                    <th>Total Completed Activities</th>
                    <th>Calls</th>
                    <th>Meetings</th>
                    <th>Emails</th>
                    <th>Tasks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@u.UserName</td>
                        <td class="fw-bold text-primary">@u.TotalActivities</td>
                        <td><span class="badge bg-light text-dark border"><i class="bi bi-telephone me-1 text-primary"></i>@u.Calls</span></td>
                        <td><span class="badge bg-light text-dark border"><i class="bi bi-people me-1 text-info"></i>@u.Meetings</span></td>
                        <td><span class="badge bg-light text-dark border"><i class="bi bi-envelope me-1 text-warning"></i>@u.Emails</span></td>
                        <td><span class="badge bg-light text-dark border"><i class="bi bi-check2-square me-1 text-success"></i>@u.Tasks</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
