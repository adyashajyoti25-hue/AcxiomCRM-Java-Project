@model AcxiomCRM.Application.DTOs.CustomerDto
@{
    ViewData["Title"] = Model.CustomerName;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">@Model.CustomerName</h3>
            <span class="badge bg-primary bg-opacity-10 text-primary">@Model.CustomerCode</span>
            <span class="badge-status @(Model.Status == CustomerStatus.Active ? "badge-status-active" : "badge-status-inactive")">
                @Model.Status
            </span>
        </div>
        <p class="text-muted small mb-0">Customer profile, commercial opportunities, and relationship activity</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-success">
            <i class="bi bi-briefcase me-1"></i> Add Opportunity
        </a>
        <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-info text-white">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-sm btn-light border">Back</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Account Info Card -->
    <div class="col-lg-4">
        <div class="crm-card mb-3">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-building me-2 text-primary"></i>Company Coordinates</h5>
            </div>
            <div class="crm-card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Company:</dt>
                    <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-5 text-muted">Email:</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-5 text-muted">Phone:</dt>
                    <dd class="col-sm-7"><a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a></dd>

                    <dt class="col-sm-5 text-muted">Address:</dt>
                    <dd class="col-sm-7">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-5 text-muted">City / State:</dt>
                    <dd class="col-sm-7">@(Model.City != null ? $"{Model.City}, {Model.State}" : "-")</dd>

                    <dt class="col-sm-5 text-muted">Assigned Exec:</dt>
                    <dd class="col-sm-7 fw-medium text-dark">@Model.AssignedUserName</dd>

                    <dt class="col-sm-5 text-muted">Created Date:</dt>
                    <dd class="col-sm-7">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="crm-card mb-0">
                <div class="crm-card-header">
                    <h5 class="crm-card-title"><i class="bi bi-journal-text me-2 text-secondary"></i>Account Notes</h5>
                </div>
                <div class="crm-card-body small text-secondary">
                    @Model.Notes
                </div>
            </div>
        }
    </div>

    <!-- Commercial Pipeline & Activities -->
    <div class="col-lg-8">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-briefcase me-2 text-success"></i>Opportunities Pipeline</h5>
                <a asp-controller="Opportunity" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-lg me-1"></i>New Deal
                </a>
            </div>
            <div class="crm-card-body p-0">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between small">
                    <span>Active Opportunities: <strong>@Model.ActiveOpportunitiesCount</strong></span>
                    <span>Total Won Revenue: <strong class="text-success">@Model.TotalWonValue.ToString("C0")</strong></span>
                </div>
                <div class="p-3 text-center text-muted small">
                    <a asp-controller="Opportunity" asp-action="Index" asp-route-search="@Model.CustomerName" class="btn btn-sm btn-light border">
                        <i class="bi bi-search me-1"></i>View All Opportunities for @Model.CustomerName
                    </a>
                </div>
            </div>
        </div>

        <div class="crm-card mb-0">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-calendar-check me-2 text-info"></i>Follow-Up Schedule</h5>
                <a asp-controller="FollowUp" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-plus-lg me-1"></i>Schedule
                </a>
            </div>
            <div class="crm-card-body p-3 text-center text-muted small">
                <a asp-controller="FollowUp" asp-action="Index" asp-route-search="@Model.CustomerName" class="btn btn-sm btn-light border">
                    <i class="bi bi-search me-1"></i>View Follow-Up Tasks for @Model.CustomerName
                </a>
            </div>
        </div>
    </div>
</div>
