@model AcxiomCRM.Application.DTOs.CustomerCreateUpdateDto
@{
    ViewData["Title"] = "New Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-0">Create Customer</h3>
                <p class="text-muted small mb-0">Register a new client organization or commercial contact</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Customer Information</h5>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-semibold text-secondary">Customer Name *</label>
                            <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Corp or John Smith" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold text-secondary">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Global Logistics" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address *</label>
                            <input asp-for="Email" class="form-control" placeholder="client@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold text-secondary">Phone Number *</label>
                            <input asp-for="Phone" class="form-control" placeholder="e.g. 9876543210" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-secondary">Street Address</label>
                            <input asp-for="Address" class="form-control" placeholder="e.g. 101 Tech Boulevard" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label small fw-semibold text-secondary">City</label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="State" class="form-label small fw-semibold text-secondary">State</label>
                            <input asp-for="State" class="form-control" placeholder="State / Province" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerStatus>()"></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-secondary">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Assign to Me / Default --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold text-secondary">Account Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key contact person, billing cycle preferences, SLA requirements..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i>Save Customer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
