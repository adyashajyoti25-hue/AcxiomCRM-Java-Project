@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Security & Business Audit Logs";
    var filter = ViewBag.Filter as AcxiomCRM.Application.DTOs.AuditLogFilterDto;
    var users = ViewBag.Users as List<AcxiomCRM.Application.DTOs.UserDto>;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">System Audit Trail</h3>
        <p class="text-muted small mb-0">Immutable, append-oriented audit records of security events, administrative changes, and CRM data mutations</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="UserId" class="form-select form-select-sm">
                    <option value="">All Users / Operators</option>
                    @if (users != null)
                    {
                        foreach (var u in users)
                        {
                            <option value="@u.Id" selected="@(filter?.UserId == u.Id)">@u.FullName (@u.Email)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="text" name="Action" class="form-control form-control-sm" placeholder="Action (e.g. Login, Create)" value="@filter?.Action" />
            </div>
            <div class="col-md-2">
                <input type="text" name="EntityName" class="form-control form-control-sm" placeholder="Module / Entity" value="@filter?.EntityName" />
            </div>
            <div class="col-md-2">
                <input type="date" name="FromDate" class="form-control form-control-sm" value="@(filter?.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Operator</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record ID</th>
                            <th>Changes (Old &rarr; New)</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td class="small text-muted">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <span class="fw-semibold text-dark">@(log.UserEmail ?? "System")</span>
                                </td>
                                <td>
                                    <span class="badge @(log.Action == "Login" ? "bg-success" : log.Action == "FailedLogin" || log.Action == "Lockout" ? "bg-danger" : log.Action == "Delete" ? "bg-danger" : log.Action == "Convert" ? "bg-purple text-white" : log.Action == "Create" ? "bg-primary" : "bg-info")"
                                          style="@(log.Action == "Convert" ? "background-color: #8b5cf6;" : "")">
                                        @log.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                                <td class="small font-monospace">@(log.RecordId ?? "-")</td>
                                <td class="small">
                                    @if (!string.IsNullOrEmpty(log.OldValue))
                                    {
                                        <div class="text-danger text-truncate" style="max-width: 250px;"><i class="bi bi-dash-circle me-1"></i>@log.OldValue</div>
                                    }
                                    @if (!string.IsNullOrEmpty(log.NewValue))
                                    {
                                        <div class="text-success text-truncate" style="max-width: 250px;"><i class="bi bi-plus-circle me-1"></i>@log.NewValue</div>
                                    }
                                </td>
                                <td class="small font-monospace text-muted">@(log.IpAddress ?? "127.0.0.1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-journal-text"></i>
                <h5>No Audit Records Found</h5>
                <p class="small">Audit events will automatically appear here as users perform actions.</p>
            </div>
        }
    </div>
</div>
