@model AcxiomCRM.Application.DTOs.UserDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">My Account Profile</h3>
        <p class="text-muted small mb-0">Manage your CRM identity, credentials, and organizational scope</p>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="crm-card text-center p-4">
            <div class="avatar-initial mx-auto mb-3" style="width: 72px; height: 72px; font-size: 1.8rem;">
                @(Model.Email.Substring(0, 1).ToUpper())
            </div>
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <p class="text-muted small mb-2">@Model.Email</p>
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">@Model.Role</span>
            <div class="mt-4 pt-3 border-top text-start small">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Account Status:</span>
                    <span class="badge bg-success">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Department:</span>
                    <span class="fw-semibold">@(Model.Department ?? "General")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Member Since:</span>
                    <span>@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Last Login:</span>
                    <span>@(Model.LastLoginDate?.ToString("MMM dd, yyyy HH:mm") ?? "First Session")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-shield-lock me-2 text-primary"></i>Security & Permissions</h5>
            </div>
            <div class="crm-card-body">
                <div class="alert alert-info d-flex align-items-center gap-3">
                    <i class="bi bi-info-circle-fill fs-4 text-info"></i>
                    <div>
                        <strong>Role Permissions Assigned:</strong> You are currently operating under the <strong>@Model.Role</strong> role.
                        @if (Model.Role == "Admin")
                        {
                            <div>You have unrestricted administrative access across user accounts, security logs, CRM master records, and reports.</div>
                        }
                        else if (Model.Role == "Manager")
                        {
                            <div>You can monitor team sales performance, pipeline distribution, assigned leads, and management reports.</div>
                        }
                        else
                        {
                            <div>You have scoped access to your assigned customers, leads, opportunities, follow-up calendar, and performance metrics.</div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <h6 class="fw-bold text-dark mb-2">Password Policy Applied</h6>
                    <ul class="small text-secondary ps-3">
                        <li>Managed securely using ASP.NET Core Identity adaptive PBKDF2 hashing.</li>
                        <li>Configurable minimum 8 characters with alphanumeric complexity rules.</li>
                        <li>Automatic lockout after 5 consecutive failed login attempts.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
