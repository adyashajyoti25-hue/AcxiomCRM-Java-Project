@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4 text-center">
        <div class="card shadow border-0 rounded-4 p-4">
            <div class="text-danger display-3 mb-3"><i class="bi bi-shield-slash-fill"></i></div>
            <h3 class="fw-bold text-dark">Account Temporarily Locked</h3>
            <p class="text-muted small">
                This account has been temporarily locked due to multiple failed login attempts.
                Please wait 15 minutes before trying again, or contact your CRM system administrator to unlock your account immediately.
            </p>
            <div class="mt-3">
                <a asp-action="Login" class="btn btn-outline-primary w-100"><i class="bi bi-arrow-left me-1"></i>Back to Sign In</a>
            </div>
        </div>
    </div>
</div>
