@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4 text-center">
        <div class="card shadow border-0 rounded-4 p-4">
            <div class="text-warning display-3 mb-3"><i class="bi bi-shield-lock-fill"></i></div>
            <h3 class="fw-bold text-dark">Access Denied</h3>
            <p class="text-muted small">
                You do not have the necessary permissions or role to access this CRM resource.
                If you believe this is an error, please contact your organization administrator.
            </p>
            <div class="mt-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100"><i class="bi bi-house me-1"></i>Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
