@model AcxiomCRM.Application.DTOs.LoginDto
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #1e3a8a, #0284c7) !important;">
                <div class="display-6 mb-1"><i class="bi bi-shield-check"></i></div>
                <h3 class="fw-bold mb-0">AcxiomCRM</h3>
                <p class="text-white-50 small mb-0">Enterprise CRM Portal</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Portal
                    </button>

                    <div class="text-center small text-muted">
                        Don't have an account? <a asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>

                <hr class="my-4 text-muted" />

                <!-- Seeded Demo Credentials Hint Box -->
                <div class="bg-light p-3 rounded-3 small">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Demo Credentials:</div>
                    <ul class="mb-0 ps-3 text-secondary" style="font-size: 0.8rem;">
                        <li><strong>Admin:</strong> admin@acxiomcrm.com / Admin@12345</li>
                        <li><strong>Manager:</strong> manager@acxiomcrm.com / Manager@12345</li>
                        <li><strong>Executive:</strong> executive@acxiomcrm.com / Executive@12345</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
