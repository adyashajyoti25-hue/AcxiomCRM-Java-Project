@model AcxiomCRM.Application.DTOs.LeadCreateUpdateDto
@{
    ViewData["Title"] = $"Edit {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-0">Edit Lead: @Model.LeadName</h3>
                <p class="text-muted small mb-0">Lead Code: <span class="badge bg-light text-primary border">@Model.LeadCode</span></p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Details</a>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pencil-square me-2 text-primary"></i>Update Lead Details</h5>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label small fw-semibold text-secondary">Lead Name *</label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold text-secondary">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email Address *</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold text-secondary">Phone Number *</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label small fw-semibold text-secondary">Lead Source</label>
                            <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()"></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label small fw-semibold text-secondary">Priority</label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary">Lead Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label small fw-semibold text-secondary">Expected Value ($)</label>
                            <input asp-for="ExpectedValue" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-secondary">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Unassigned --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold text-secondary">Lead Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Update Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
