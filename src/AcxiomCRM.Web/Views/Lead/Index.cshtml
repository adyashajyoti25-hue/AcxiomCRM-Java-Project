@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.LeadDto>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Leads</h3>
        <p class="text-muted small mb-0">Prospective pipeline capture, sales qualification, and conversion lifecycle</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-funnel-fill me-1"></i> Add Lead
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, code, email, company..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<LeadStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="assignedTo" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Assigned Reps</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Contact Info</th>
                            <th>Source</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Assigned To</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@l.LeadCode</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-semibold text-dark text-decoration-none">
                                        @l.LeadName
                                    </a>
                                    @if (!string.IsNullOrEmpty(l.CompanyName))
                                    {
                                        <div class="small text-muted">@l.CompanyName</div>
                                    }
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope text-muted me-1"></i><small>@l.Email</small></div>
                                    <div><i class="bi bi-telephone text-muted me-1"></i><small>@l.Phone</small></div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@l.Source</span>
                                </td>
                                <td>
                                    <span class="badge @(l.Priority == LeadPriority.High ? "bg-danger bg-opacity-10 text-danger" : l.Priority == LeadPriority.Medium ? "bg-warning bg-opacity-10 text-warning" : "bg-light text-secondary border")">
                                        @l.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status badge-status-@l.Status.ToString().ToLower()">
                                        @l.Status
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">
                                    @(l.ExpectedValue > 0 ? l.ExpectedValue.ToString("C0") : "-")
                                </td>
                                <td class="small">@l.AssignedUserName</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-light border" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (l.Status != LeadStatus.Converted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-light border" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-light border text-success" title="Convert to Customer">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" id="del-@l.LeadId" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-light border text-danger" title="Delete" onclick="confirmAction('Are you sure you want to remove this lead?', 'del-@l.LeadId')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border align-self-center py-2 px-2 ms-1">Converted</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-funnel"></i>
                <h5>No Leads Found</h5>
                <p class="small">Capture new prospective business by creating your first lead.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Create Lead</a>
            </div>
        }
    </div>
</div>
