@model AcxiomCRM.Application.DTOs.FollowUpCreateUpdateDto
@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-0">Reschedule / Edit Follow-Up</h3>
                <p class="text-muted small mb-0">Modify due date, status, agenda, or assigned user</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-pencil-square me-2 text-primary"></i>Follow-Up Details</h5>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label small fw-semibold text-secondary">Subject / Objective *</label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold text-secondary">Follow-Up Date *</label>
                            <input asp-for="FollowUpDate" type="date" class="form-control" value="@Model.FollowUpDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold text-secondary">Activity Type</label>
                            <select asp-for="FollowUpType" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpType>()"></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold text-secondary">Related Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                                <option value="">-- None / Prospect Lead --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold text-secondary">Related Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadsList">
                                <option value="">-- None / Existing Customer --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-secondary">Assigned User *</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpStatus>()"></select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold text-secondary">Remarks & Agenda</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Update Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
