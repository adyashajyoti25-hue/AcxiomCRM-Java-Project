@model AcxiomCRM.Application.DTOs.PagedResult<AcxiomCRM.Application.DTOs.FollowUpDto>
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Follow-Ups & Reminders</h3>
        <p class="text-muted small mb-0">Scheduled client touchpoints, follow-up calendar, overdue resolution, and status tracking</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Upcoming" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar-event me-1"></i> Upcoming
        </a>
        <a asp-action="Overdue" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-exclamation-circle me-1"></i> Overdue
        </a>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Search subject or account..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpType>()">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="date" class="form-control form-control-sm" value="@ViewBag.Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Data Table Card -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="crm-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Subject</th>
                            <th>Related To</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Remarks</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @(f.FollowUpType == FollowUpType.Call ? "bi-telephone" : f.FollowUpType == FollowUpType.Meeting ? "bi-people" : f.FollowUpType == FollowUpType.Email ? "bi-envelope" : "bi-check2-square") me-1"></i>
                                        @f.FollowUpType
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@f.Subject</td>
                                <td class="small text-muted">
                                    @(f.CustomerName != null ? $"Customer: {f.CustomerName}" : f.LeadName != null ? $"Lead: {f.LeadName}" : f.OpportunityName != null ? $"Deal: {f.OpportunityName}" : "-")
                                </td>
                                <td>
                                    <span class="@(f.IsOverdue ? "text-danger fw-bold" : "text-dark")">
                                        @f.FollowUpDate.ToString("MMM dd, yyyy")
                                    </span>
                                    @if (f.IsOverdue)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-status badge-status-@f.Status.ToString().ToLower()">
                                        @f.Status
                                    </span>
                                </td>
                                <td class="small">@f.AssignedUserName</td>
                                <td class="small text-muted text-truncate" style="max-width: 150px;">
                                    @(f.Remarks ?? "-")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (f.Status == FollowUpStatus.Planned)
                                        {
                                            <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-light border text-success" title="Mark Completed">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-light border" title="Edit / Reschedule">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Cancel" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-light border text-secondary" title="Cancel Follow-Up">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small align-self-center pe-2">Archived</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3">
                <partial name="_Pagination" model="Model" />
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <h5>No Follow-Ups Found</h5>
                <p class="small">Stay organized with scheduled client touchpoints and reminder alerts.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Schedule Follow-Up</a>
            </div>
        }
    </div>
</div>
