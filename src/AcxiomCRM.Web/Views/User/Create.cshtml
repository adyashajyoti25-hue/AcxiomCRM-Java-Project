@model AcxiomCRM.Application.DTOs.UserCreateDto
@{
    ViewData["Title"] = "Provision User";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-0">Provision System Operator</h3>
                <p class="text-muted small mb-0">Create a user account and assign authorized CRM security roles</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <h5 class="crm-card-title"><i class="bi bi-person-plus me-2 text-primary"></i>Account Details</h5>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Full Name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary">Corporate Email *</label>
                            <input asp-for="Email" class="form-control" placeholder="johndoe@acxiomcrm.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label small fw-semibold text-secondary">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="Enterprise Sales / Management" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label small fw-semibold text-secondary">Assigned Security Role *</label>
                            <select asp-for="Role" class="form-select" asp-items="ViewBag.RolesList">
                                <option value="">-- Select Role --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary">Initial Password *</label>
                            <input asp-for="Password" class="form-control" placeholder="Min. 8 characters" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkActive" checked>
                                <label class="form-check-label small fw-semibold" for="chkActive">
                                    Account is immediately Active
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i>Provision Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
