@model List<AcxiomCRM.Application.DTOs.UserDto>
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">User & Role Administration</h3>
        <p class="text-muted small mb-0">Manage system operator identities, security policies, role entitlements, and access control</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Provision User
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="crm-card mb-4">
    <div class="crm-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, email, department..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="crm-card">
    <div class="crm-card-body p-0">
        <div class="table-responsive">
            <table class="crm-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Assigned Role</th>
                        <th>Status</th>
                        <th>Security / Lockout</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-initial" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                        @u.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold text-dark">@u.FullName</span>
                                </div>
                            </td>
                            <td><small class="text-muted">@u.Email</small></td>
                            <td><small>@(u.Department ?? "General")</small></td>
                            <td>
                                <span class="badge @(u.Role == "Admin" ? "bg-danger" : u.Role == "Manager" ? "bg-primary" : "bg-info")">
                                    @u.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge @(u.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-unlock-fill me-1"></i>Normal</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(u.LastLoginDate?.ToString("MMM dd, yyyy HH:mm") ?? "Never")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-light border" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-light border" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" id="tog-@u.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-light border @(u.IsActive ? "text-danger" : "text-success")"
                                                title="@(u.IsActive ? "Deactivate" : "Activate")"
                                                onclick="confirmAction('Are you sure you want to change this user status?', 'tog-@u.Id')">
                                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
